# ---------------- Discord ----------------
DISCORD_TOKEN=                      # Discord Bot Token
GUILD_ID=                           # Server-ID, z.B. 123456789012345678

# Intervall zwischen Updates in Sekunden (Default 14400 = 4 Stunden)
UPDATE_INTERVAL=14400

LOG_LEVEL=INFO

# Text-Channel fuer allgemeine Bot-Logs (Start, Sync, Warnungen/Fehler - 0 = deaktiviert)
CHANNEL_ID_LOG=0
# Webhook-URL desselben Channels, damit auch deploy.sh (laeuft unabhaengig vom Bot) dorthin posten kann
DISCORD_LOG_WEBHOOK_URL=
# Optional: eigener Channel nur fuer Follower-Update-Logs (0 = CHANNEL_ID_LOG mitbenutzen)
CHANNEL_ID_LOG_FOLLOWER=0

# ---------------- Instagram ----------------
# Channel-ID eines Voice-/Stage-Channels, der umbenannt werden soll (0 = deaktiviert)
CHANNEL_ID_INSTAGRAM=0
INSTAGRAM_USERNAME=
# Nur noetig, falls Instagram die Server-IP auf die Login-Seite umleitet (siehe README):
# kompletter Cookie-Header eines eingeloggten Browsers
INSTAGRAM_COOKIE=

# ---------------- TikTok ----------------
CHANNEL_ID_TIKTOK=0
TIKTOK_USERNAME=

# ---------------- Datenbank (MySQL) ----------------
# Speichert jeden Follower-Abruf fuer /statistik social
# Tabelle wird beim ersten Start automatisch angelegt - die Datenbank selbst
# (DB_NAME) muss bereits existieren.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=followerDB
DB_USER=
DB_PASSWORD=

# ---------------- Webpanel (optional) ----------------
# Kleines Admin-Panel mit Discord-Login: nur Mitglieder mit ROLE_ADMIN_ID
# koennen den Bot neustarten, Slash-Commands neu registrieren, per Git
# deployen oder einen Follower-Sync anstossen (siehe README, Abschnitt Webpanel).
WEB_ENABLED=false
WEB_PORT=3000
# Oeffentlich erreichbare Basis-URL des Panels (ohne Slash am Ende). Muss exakt
# mit einer im Discord Developer Portal hinterlegten OAuth2-Redirect-URL
# uebereinstimmen: <WEB_BASE_URL>/auth/callback
WEB_BASE_URL=http://localhost:3000
# Discord Developer Portal -> Applications -> deine App -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Zufaelliger, langer String zum Signieren der Session-Cookies, z.B. per
# `openssl rand -hex 32` oder `python -c "import secrets; print(secrets.token_hex(32))"` erzeugen.
SESSION_SECRET=
# Rolle, deren Mitglieder Zugriff auf das Webpanel haben (Rollen-ID, Rechtsklick -> ID kopieren)
ROLE_ADMIN_ID=
