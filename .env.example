# ---------------- Discord ----------------
DISCORD_TOKEN=                      # Discord Bot Token
GUILD_ID=                           # Server-ID, z.B. 123456789012345678

# Intervall zwischen Updates in Sekunden (Default 14400 = 4 Stunden)
UPDATE_INTERVAL=14400

LOG_LEVEL=INFO

# ---------------- Instagram ----------------
# Channel-ID eines Voice-/Stage-Channels, der umbenannt werden soll (0 = deaktiviert)
CHANNEL_ID_INSTAGRAM=0
INSTAGRAM_USERNAME=

# ---------------- TikTok ----------------
CHANNEL_ID_TIKTOK=0
TIKTOK_USERNAME=

# ---------------- YouTube ----------------
# Offizielle YouTube Data API v3 - kostenloser API-Key aus der Google Cloud Console
# (siehe README fuer die Schritt-fuer-Schritt-Anleitung)
CHANNEL_ID_YOUTUBE=0
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=                 # Die YouTube-Channel-ID (beginnt meist mit UC...)

# ---------------- Twitch ----------------
# Erfordert einmaliges Setup ueber twitch_auth.py (siehe README) - Followerzahlen
# sind seit 2023 nur mit User-Access-Token des Broadcasters abrufbar.
CHANNEL_ID_TWITCH=0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_LOGIN=           # Twitch-Login-Name des Streamers, ohne @
TWITCH_REFRESH_TOKEN=               # wird von twitch_auth.py ausgegeben
TWITCH_REDIRECT_URI=http://localhost:17563/callback

# ---------------- Datenbank (MySQL) ----------------
# Speichert jeden Follower-Abruf fuer /statistik social
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=followerDB
DB_USER=
DB_PASSWORD=
