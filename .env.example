# ---------------- Discord ----------------
DISCORD_TOKEN=                      # Discord Bot Token
GUILD_ID=                           # Server-ID, z.B. 123456789012345678

# Intervall zwischen Updates in Sekunden (Default 14400 = 4 Stunden)
UPDATE_INTERVAL=14400

LOG_LEVEL=INFO

# Text-Channel fuer Bot-Warnungen/Fehler (0 = deaktiviert)
CHANNEL_ID_LOG=0
# Webhook-URL desselben Channels, damit auch deploy.sh (laeuft unabhaengig vom Bot) dorthin posten kann
DISCORD_LOG_WEBHOOK_URL=

# ---------------- Instagram ----------------
# Channel-ID eines Voice-/Stage-Channels, der umbenannt werden soll (0 = deaktiviert)
CHANNEL_ID_INSTAGRAM=0
INSTAGRAM_USERNAME=

# ---------------- TikTok ----------------
CHANNEL_ID_TIKTOK=0
TIKTOK_USERNAME=

# ---------------- YouTube ----------------
# Kein API-Key noetig - liest ueber YouTubes oeffentliches InnerTube-Browse-API
CHANNEL_ID_YOUTUBE=0
YOUTUBE_CHANNEL_ID=                 # Die YouTube-Channel-ID (beginnt meist mit UC...)

# ---------------- Twitch ----------------
# Kein Developer-App/OAuth noetig - liest ueber decapi.me (inoffiziell)
CHANNEL_ID_TWITCH=0
TWITCH_BROADCASTER_LOGIN=           # Twitch-Login-Name des Streamers, ohne @

# ---------------- Datenbank (MySQL) ----------------
# Speichert jeden Follower-Abruf fuer /statistik social
# Tabelle wird beim ersten Start automatisch angelegt - die Datenbank selbst
# (DB_NAME) muss bereits existieren.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=followerDB
DB_USER=
DB_PASSWORD=
